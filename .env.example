# ─────────────────────────────────────────────────────────────────────────────
# CAPTCHA Solving & Verification Tool — environment variables
#
# Copy this file to .env, then fill in any values you want to override.
# .env is git-ignored; never commit it.
# All values below are either defaults (safe to leave unchanged locally)
# or the providers' published TEST keys (safe to publish).
# ─────────────────────────────────────────────────────────────────────────────

# ── API ───────────────────────────────────────────────────────────────────────
API_KEY=changeme-local
HOST=127.0.0.1
PORT=8000
DEBUG=false

# ── Storage ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///data/captcha_tool.db

# ── Provider test keys (published by each provider — safe to commit) ──────────

# Google reCAPTCHA v2 test keys
# Source: https://developers.google.com/recaptcha/docs/faq#id-like-to-run-automated-tests-with-recaptcha.-what-should-i-do
RECAPTCHA_SITEKEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# hCaptcha test keys
# Source: https://docs.hcaptcha.com/#integration-testing-test-keys
HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# Cloudflare Turnstile test keys
# Source: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Sitekeys: 1x...AA pass, 2x...AB fail, 1x...BB / 2x...BB invisible pass / fail, 3x...FF forces interactive
# Secrets:  1x...AA always passes, 2x...AA always fails, 3x...AA returns timeout-or-duplicate
# The dummy sitekeys issue the fixed token XXXX.DUMMY.TOKEN.XXXX
TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# ── Solver ────────────────────────────────────────────────────────────────────
CRNN_MODEL_PATH=data/models/crnn.onnx
CONFIDENCE_THRESHOLD=0.60
SOLVER_TIMEOUT_S=10.0

# ── Verification ──────────────────────────────────────────────────────────────
VERIFY_TIMEOUT_S=5.0
VERIFY_RETRIES=1
# Ceiling on token age; each provider also has its own lifetime (reCAPTCHA/hCaptcha 120 s, Turnstile 300 s)
TOKEN_MAX_AGE_S=300

# ── Site scan ─────────────────────────────────────────────────────────────────
SCAN_CONCURRENCY=5
SCAN_TIMEOUT_S=20.0

# ── Optional: third-party vision solver (M7) ───────────────────────────────────
# OFF unless a key is set. It runs only after the local models fail to give an accepted
# answer, and it SENDS THE IMAGE to the provider. Cost is computed from the provider's
# reported token usage. Leave the key blank to keep everything local and free.
# VISION_API_KEY=
# VISION_PROVIDER=anthropic            # anthropic | openai (OpenAI-compatible)
# VISION_MODEL=claude-haiku-5-5        # $0.10 in / $0.50 out per MTok; any other model needs prices below
# VISION_BASE_URL=                     # default per provider
# VISION_PRICE_IN_PER_MTOK=
# VISION_PRICE_OUT_PER_MTOK=
# VISION_BUDGET_USD_PER_DAY=1.00       # refuses further calls once reached
# VISION_MAX_CALLS_PER_MIN=20
# VISION_ENABLED=true                  # set false to disable even with a key present
